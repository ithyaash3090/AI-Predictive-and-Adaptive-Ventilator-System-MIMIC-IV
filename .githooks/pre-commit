        CURRENT_USER=$(git config user.name)
        CURRENT_EMAIL=$(git config user.email)

        if [ "$CURRENT_USER" != "ithyaash3090" ] && [ "$CURRENT_EMAIL" != "ithyaash3090@gmail.com" ]; then
            echo "=========================================================================="
            echo "⛔ ACCESS DENIED: Only ithyaash3090 has the access to this weekly_schedule.md file."
            echo "Please unstage WEEKLY_SCHEDULE.md before committing:"
            echo "    git restore --staged WEEKLY_SCHEDULE.md"
            echo "    git restore WEEKLY_SCHEDULE.md"
            echo "=========================================================================="
            exit 1
        fi
    fi
done

exit 0
